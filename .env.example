# Адрес PocketBase для браузера. Пусто — тот же домен (в production nginx проксирует /api на PocketBase,
# в разработке Vite проксирует /api на PB_PROXY_TARGET).
VITE_API_URL=

# Куда Vite в режиме разработки проксирует /api и /_/ (по умолчанию локальный PocketBase: npm run pb)
PB_PROXY_TARGET=http://127.0.0.1:8090
